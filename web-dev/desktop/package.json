{
  "name": "tsukihime",
  "productName": "Tsukihime",
  "version": "2026.11.13",
  "description": "An unofficial fan rebuild of the Tsukihime remake, as a desktop app",
  "homepage": "https://arcueid.date",
  "author": "TsukiREbuild",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron ."
  },
  "devDependencies": {
    "electron": "45.3.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "date.arcueid.tsukirebuild",
    "productName": "Tsukihime",
    "artifactName": "Tsukihime-${os}-${arch}.${ext}",
    "directories": { "output": "out", "buildResources": "build" },
    "files": ["main.js", "preload.js", "updater.js", "package.json"],
    "extraResources": [
      { "from": "../../web/app", "to": "www", "filter": ["**/*", "!**/.*"] },
      { "from": "../../web/assets", "to": "www/assets", "filter": ["**/*", "!voice/**", "!se/**", "!ja/**", "!**/.*"] },
      { "from": "out/bundle", "to": "www" }
    ],
    "electronLanguages": ["en-US", "en"],
    "publish": null,
    "mac": {
      "target": [{ "target": "dmg", "arch": ["universal"] }],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.games",
      "identity": "-",
      "sign": "build/sign-mac.js",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": { "format": "UDZO", "writeUpdateInfo": false },
    "win": {
      "target": [{ "target": "zip", "arch": ["x64"] }],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [{ "target": "AppImage", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "category": "Game",
      "extraResources": [{ "from": "build/icon.png", "to": "icon.png" }]
    }
  }
}
